/* GLOBAL RESET */
* {
    font-family: "Segoe UI", sans-serif;
    font-size: 20px;
    color: #FFFFFF;
}

/* AAC BLOCK TITLES */
QLabel[aacBlockTitle="true"] {
    font-size: 24px;
    font-weight: 600;
    padding-top: 12px;
    padding-bottom: 4px;
}

/* AAC ROW SPACING (labels, sliders, combos, toggles) */
QLabel, QComboBox, QSlider, AACToggle {
    padding-top: 2px;
    padding-bottom: 2px;
}

/* MAIN WINDOW BACKGROUND */
QWidget {
    background-color: #000000;
}

/* BUTTONS — unified size, spacing, and shape */
QPushButton {
    background-color: #222222;
    border: 3px solid #FFFFFF;
    border-radius: 12px;
    padding: 16px 20px;      /* unified internal size */
    font-weight: bold;
    min-height: 56px;        /* unified button height */
    margin-top: 4px;         /* unified external spacing */
    margin-bottom: 4px;
}

/* BUTTON STATES */
QPushButton:hover {
    background-color: #333333;
}

QPushButton:pressed {
    background-color: #555555;
}

/* COMBO BOX — unified with buttons */
QComboBox {
    padding: 6px 10px;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    min-height: 44px;        /* matches AACSpeechSettingsScreen */
}

/* SLIDERS — AAC-native thick groove + large handle */
QSlider::groove:horizontal {
    height: 6px;
    background: #444444;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 24px;
    height: 24px;
    background: #FFFFFF;
    border-radius: 12px;
    margin: -10px 0;         /* centers handle visually */
}

/* TOGGLES — unified spacing */
AACToggle {
    margin-top: 4px;
    margin-bottom: 4px;
}
